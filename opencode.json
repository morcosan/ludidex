{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["./AGENTS.md"],
  "permission": {
    "*": "ask",
    "external_directory": "deny",
    "todowrite": "allow",
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "bash": {
      "*": "ask",
      "ls": "allow",
      "ls *": "allow",
      "cat": "allow",
      "cat *": "allow",
      "grep *": "allow",
      "head": "allow",
      "head *": "allow",
      "pnpm lint-code": "allow",
      "git status": "allow",
      "git status *": "allow",
      "git log": "allow",
      "git log *": "allow",
      "git log *--output*": "deny",
      "git show": "allow",
      "git show *": "allow",
      "git show *--output*": "deny",
      "git diff": "allow",
      "git diff *": "allow",
      "git diff *--output*": "deny",
      "git diff *--no-index*": "deny",
      "git diff *--ext-diff*": "deny"
    }
  }
}
