    "@fortawesome/react-fontawesome": "^3.5.0",
    "@mantine/core": "^9.8.0",
    "@tanstack/react-query": "^5.107.1",
    "clsx": "^2.1.1",
    "i18next": "^26.7.2",
    "lodash-es": "^4.18.1",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "react-i18next": "^17.1.13",
    "react-router": "^8.5.1",
