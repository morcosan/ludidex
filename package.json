{
  "name": "ludidex",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "app--dev": "vite --port 8080",
    "app--build": "vite build --outDir ../dist-app",
    "app--preview": "vite preview --outDir ../dist-app --port 8080",
    "docs--dev": "storybook dev -p 6006 --no-open",
    "docs--build": "storybook build -o dist-docs",
    "docs--preview": "vite preview --outDir ../dist-docs --port 6006",
    "utils--build-tokens": "tsx scripts/design-tokens/builder.ts src/ds/tokens/tokens.js src/ds/tokens/output",
    "lint-code": "oxlint && tsc -b --noEmit",
    "lint-commit": "commitlint --edit",
    "prepare": "husky"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@mantine/core": "^9.7.0",
    "@tanstack/react-query": "^5.104.1",
    "clsx": "^2.1.1",
    "i18next": "^26.4.2",
    "lodash-es": "^4.18.1",
    "lucide-react": "^1.55.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.16",
    "react-router": "^8.4.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^21.2.3",
    "@faker-js/faker": "^10.6.0",
    "@mdx-js/react": "^3.1.1",
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/addon-vitest": "10.6.1",
    "@storybook/react-vite": "10.6.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/estree": "^1.0.9",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "latest",
    "@vitest/coverage-v8": "latest",
    "commitlint": "^21.2.3",
    "husky": "^9.1.7",
    "oxlint": "^1.81.0",
    "playwright": "latest",
    "postcss-url": "^10.1.4",
    "prettier": "^3.9.9",
    "prettier-plugin-css-order": "^2.2.0",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "remark-gfm": "^4.0.1",
    "storybook": "10.6.1",
    "style-dictionary": "^5.6.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "latest"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
