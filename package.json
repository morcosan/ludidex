    "utils--build-tokens": "tsx scripts/design-tokens/builder.ts src/design-system/tokens",
    "lint-code": "oxlint && tsc -b --noEmit",
    "lint-commit": "commitlint --edit",
    "prepare": "husky"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
