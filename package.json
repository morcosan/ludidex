    "storybook": "10.6.7",
    "style-dictionary": "^5.8.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "latest"
